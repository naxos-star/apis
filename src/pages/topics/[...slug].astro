---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const topics = await getCollection('topics');
  return topics.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={`${entry.data.title} | Apis mellifera`} description={entry.data.summary}>
  <div class="wrap">
    <article>
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.summary}</p>
      {entry.data.image && <img src={entry.data.image} alt={entry.data.imageAlt} />}
      <Content />
      <a class="back" href="/#topics">Back to all topics</a>
    </article>
  </div>
</Base>
